{
  "info": {
    "name": "LeadFlow CRM API",
    "description": "REST API for LeadFlow CRM",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/register", "body": { "raw": "{\"name\":\"Test User\",\"email\":\"test@example.com\",\"password\":\"password123\"}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "Login",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/login", "body": { "raw": "{\"email\":\"admin@leadflow.com\",\"password\":\"admin123\"}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "Get Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/users", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Create User",
          "request": { "method": "POST", "url": "{{baseUrl}}/users", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "raw": "{\"name\":\"New User\",\"email\":\"new@user.com\",\"password\":\"password123\",\"role\":\"member\"}", "options": { "raw": { "language": "json" } } } }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "Get Leads",
          "request": { "method": "GET", "url": "{{baseUrl}}/leads?page=1&limit=25", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Create Lead",
          "request": { "method": "POST", "url": "{{baseUrl}}/leads", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "raw": "{\"name\":\"New Lead\",\"email\":\"lead@company.com\",\"company\":\"Company Inc\",\"status\":\"new\",\"priority\":\"medium\",\"source\":\"website\",\"budget\":50000}", "options": { "raw": { "language": "json" } } } }
        },
        {
          "name": "Pipeline",
          "request": { "method": "GET", "url": "{{baseUrl}}/leads/pipeline", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": { "method": "GET", "url": "{{baseUrl}}/dashboard", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Get Notes",
          "request": { "method": "GET", "url": "{{baseUrl}}/notes?leadId=LEAD_ID", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Create Note",
          "request": { "method": "POST", "url": "{{baseUrl}}/notes", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "raw": "{\"leadId\":\"LEAD_ID\",\"message\":\"This is a test note\"}", "options": { "raw": { "language": "json" } } } }
        }
      ]
    }
  ]
}
